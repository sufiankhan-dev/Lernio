{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs"
    },
    "studio": {
      "root": "studio",
      "framework": "sanity"
    }
  },
  "rewrites": [
    {
      "source": "/studio",
      "destination": {
        "service": "studio",
        "path": "/"
      }
    },
    {
      "source": "/studio/:path*",
      "destination": {
        "service": "studio",
        "path": "/:path*"
      }
    },
    {
      "source": "/static/:path*",
      "destination": {
        "service": "studio",
        "path": "/static/:path*"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
