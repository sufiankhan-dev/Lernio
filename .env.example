# Lernio — canonical environment variable list.
# Copy to .env.local and fill in real values. Never commit .env.local.
#
# The Sanity Studio is a separate workspace and has its own env list in studio/.env.example.

# Clerk — publishable key is safe for the browser, secret key is server only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk — auth route paths and post-auth redirects.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Sanity — project coordinates. Public, safe for the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# Sanity — read token for the private dataset. Server only.
# Never prefix with NEXT_PUBLIC_, never import into a client component,
# and never pass as defineLive's browserToken.
# The search route also sends this as the bearer token to the Sanity Context MCP.
SANITY_API_READ_TOKEN=

# Intelligent search — server only, same rules as the token above.
# The LLM writes and runs GROQ against the dataset through the Context MCP,
# so the key stays on the server and never reaches the browser.
OPENAI_API_KEY=

# Model used for search. Optional; defaults to gpt-4.1.
# OPENAI_MODEL=gpt-4.1

# Slug of the Sanity Context document that scopes and instructs the agent.
# Optional. Without it the route uses the base MCP URL and relies on the inline
# system prompt alone. Create the document with:
#   npm --prefix studio run seed:search-context
SANITY_CONTEXT_SLUG=default

# Full MCP endpoint override. Optional; leave empty to let the app compose the
# URL from the Sanity project coordinates and SANITY_CONTEXT_SLUG.
SANITY_CONTEXT_MCP_URL=
