# Lernio Studio — canonical environment variable list.
# Copy to .env and fill in real values. Never commit .env.
#
# The Studio runs on its own Vite dev server (sanity dev) and loads .env from this
# folder, so the root app's .env.local is not visible here.
#
# The Sanity CLI loads every key in this file, unprefixed names included, so the
# root app's NEXT_PUBLIC_SANITY_* names also work as fallbacks.

# studio project coordinates (public, not secret)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_API_VERSION=2026-10-01

# Read token for the private dataset. Only the offline video ingestion pipeline uses
# it, to read lesson video URLs. Server only: never prefix with NEXT_PUBLIC_, never
# reach the browser. The pipeline never writes, so it needs no write token; applying
# its output is `npm run videos:import`, which uses the Sanity CLI's own login.
#
# The pipeline picks this up from the root .env.local through
# `--env-file-if-exists=../.env.local`, so you do not have to duplicate it here.
SANITY_API_READ_TOKEN=

# Optional. Overrides YouTube's public InnerTube key used by the ingestion pipeline.
# The default is YouTube's own client key, not a credential of this project.
# YOUTUBE_INNERTUBE_API_KEY=
